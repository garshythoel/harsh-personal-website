---
// "Want to chat?": a small label at the top right, beside the light. Tap it and an arm reaches
// in from the edge with a scroll, which unrolls to show a handwritten note; tap again (or
// Escape, or anywhere else) and it rolls up and the arm takes it away.
import '@fontsource/patrick-hand/latin-400.css';
import { chat } from '../../content';

---
<button class="chat-label" type="button" data-chat-toggle aria-expanded="false" aria-controls="chat-note" hidden>{chat.label}</button>
<div class="reach-lane" data-lane>
  <div class="reach" data-reach hidden>
    <!-- what the hand holds: the scroll, by its top rod -->
    <div class="held scroll-held" id="chat-note" data-note>
      <span class="rod" aria-hidden="true"></span>
      <div class="paper" data-paper>
        {chat.note.map((line) => {
          const at = line.indexOf(chat.linkText);
          return (
            <p>
              {at < 0 ? line : (
                <>{line.slice(0, at)}<a href="#contact" data-note-contact>{chat.linkText}</a>{line.slice(at + chat.linkText.length)}</>
              )}
            </p>
          );
        })}
      </div>
      <span class="rod" data-rod-end aria-hidden="true"></span>
    </div>

    <!-- the arm, in from the edge: a sleeve, its cuff, and a fist round whatever it holds -->
    <svg class="arm" viewBox="0 0 72 36" aria-hidden="true" focusable="false">
      <path d="M72 11H28M72 26H28" />
      <rect x="24" y="9" width="5" height="19" rx="1" />
      <rect x="9" y="11" width="15" height="15" rx="5" />
      <path d="M10 16H16M10 21H16" />
    </svg>
  </div>
</div>
