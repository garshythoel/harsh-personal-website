---
import '@fontsource-variable/commissioner/flar.css';
import './a.css';
import Outline from './Outline.astro';
import { name, tagline, lede, contact, outline, beliefs } from '../../content';

const ledeText = lede.replace(/\.$/, '');
---
<main class="sheet" data-sheet>
  <h1 class="name">{name}</h1>
  <!-- the roles, then what they cover: each on its own line -->
  <p class="tagline">{tagline.split(/(?<=\.) /).map((part) => <span>{part} </span>)}</p>
  <p class="lede">{ledeText}<span class="knot" data-knot>.<span class="tie" data-tie></span></span></p>

  <button class="pull" type="button" data-pull aria-label="Pull the thread to open everything" hidden>
    <span class="pull-hint" data-pull-hint aria-hidden="true">pull</span>
  </button>
  <svg class="rope" data-rope aria-hidden="true" focusable="false"><path data-rope-path /></svg>

  <Outline items={outline} />
  <Outline items={[beliefs]} />

  <footer class="contact">
    {contact.filter((c) => !c.href.includes('[')).map((c, i) => (<>{i > 0 && <span aria-hidden="true"> · </span>}<a href={c.href} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{c.label}</a></>))}
  </footer>
</main>

<div class="lamp" data-lamp>
  <button class="switch" type="button" data-switch aria-label="Turn the light off" hidden>
    <svg class="fixture" data-fixture viewBox="-20 0 40 18" width="40" height="18" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="lamp-glow" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#ffb347" stop-opacity="1" />
          <stop offset="0.22" stop-color="#ffbe5c" stop-opacity="0.62" />
          <stop offset="0.55" stop-color="#f9c978" stop-opacity="0.2" />
          <stop offset="1" stop-color="#f9c978" stop-opacity="0" />
        </radialGradient>
        <!-- the glow fades out toward the top of the page, so it never stops in a hard line
             where the page meets the browser's status bar -->
        <linearGradient id="glow-fade-ramp" gradientUnits="userSpaceOnUse" x1="0" y1="-24" x2="0" y2="26">
          <stop offset="0" stop-color="#000" />
          <stop offset="1" stop-color="#fff" />
        </linearGradient>
        <mask id="glow-fade" maskUnits="userSpaceOnUse" x="-220" y="-220" width="440" height="440">
          <rect x="-220" y="-220" width="440" height="440" fill="url(#glow-fade-ramp)" />
        </mask>
        <filter id="ray-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="1.8" />
        </filter>
      </defs>
      <!-- while the light is on: a warm pool of light, and short drawn rays around the dome -->
      <!-- the glow is centred on the dome; the gradient runs from its middle out to the edge -->
      <ellipse class="glow" data-glow cx="0" cy="8" rx="180" ry="160" fill="url(#lamp-glow)" mask="url(#glow-fade)" />
      <!-- the rays, and a soft amber copy of them behind that brightens and fades -->
      <g class="rays">
        <path class="rays-glow" d="M-15.7 10.8L-23.0 12.4M-12.6 17.4L-18.5 22.0M-7.0 21.9L-10.3 28.6M0.0 23.5L0.0 31.0M7.0 21.9L10.3 28.6M12.6 17.4L18.5 22.0M15.7 10.8L23.0 12.4" filter="url(#ray-glow)" />
        <path class="rays-line" d="M-15.7 10.8L-23.0 12.4M-12.6 17.4L-18.5 22.0M-7.0 21.9L-10.3 28.6M0.0 23.5L0.0 31.0M7.0 21.9L10.3 28.6M12.6 17.4L18.5 22.0M15.7 10.8L23.0 12.4" />
      </g>
      <path class="plate" d="M-10 0v2.6h20V0" />
      <path class="dome" d="M-15 2.6H15A15 12 0 0 1-15 2.6Z" />
      <path class="seam" d="M-9 6.2q9 4.6 18 0" />
    </svg>
    <span class="switch-hint" data-switch-hint aria-hidden="true">off</span>
  </button>
</div>

<script>
  import './knots.ts';
  import './thread.ts';
  import './lamp.ts';
</script>
