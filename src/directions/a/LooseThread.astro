---
import '@fontsource-variable/commissioner/flar.css';
// the hand the notes on the things I feel strongly about are written in
import '@fontsource/patrick-hand/latin-400.css';
import './a.css';
import Outline from './Outline.astro';
import Header from './Header.astro';
import Lamp from './Lamp.astro';
import { chat, contact, outline, beliefs } from '../../content';
---
<main class="sheet" data-sheet>
  <Header />

  <Outline items={outline} />
  <Outline items={[beliefs]} />

  <footer class="contact" id="contact">
    <p class="chat-note">{chat.note.map((line) => <span>{line} </span>)}</p>
    <p>
      <span class="chat-label">{chat.label}</span>{' '}
      {contact.filter((c) => !c.href.includes('[')).map((c, i) => (<>{i > 0 && <span aria-hidden="true"> · </span>}<a href={c.href} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{c.label}</a></>))}
    </p>
  </footer>
</main>

<Lamp />

<script>
  import './knots.ts';
  import './thread.ts';
  import './lamp.ts';
  import './notes.ts';
</script>
