---
import '@fontsource-variable/commissioner/flar.css';
import './a.css';
import Outline from './Outline.astro';
import { name, tagline, lede, contact, outline, beliefs } from '../../content';

const ledeText = lede.replace(/\.$/, '');
---
<main class="sheet" data-sheet>
  <h1 class="name">{name}</h1>
  <!-- the roles, then what they cover: each on its own line -->
  <p class="tagline">{tagline.split(/(?<=\.) /).map((part) => <span>{part} </span>)}</p>
  <p class="lede">{ledeText}<span class="knot" data-knot>.<span class="tie" data-tie></span></span></p>

  <button class="pull" type="button" data-pull aria-label="Pull the thread to open everything" hidden>
    <span class="pull-hint" data-pull-hint aria-hidden="true">pull</span>
  </button>
  <svg class="rope" data-rope aria-hidden="true" focusable="false"><path data-rope-path /></svg>

  <Outline items={outline} />
  <Outline items={[beliefs]} />

  <footer class="contact">
    {contact.filter((c) => !c.href.includes('[')).map((c, i) => (<>{i > 0 && <span aria-hidden="true"> · </span>}<a href={c.href} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{c.label}</a></>))}
  </footer>
</main>

<div class="lamp" data-lamp>
  <button class="switch" type="button" data-switch aria-label="Turn the light off" hidden>
    <svg class="fixture" data-fixture viewBox="-20 0 40 18" width="40" height="18" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="lamp-glow" cx="0.5" cy="0" r="0.75">
          <stop offset="0" stop-color="#f7c76a" stop-opacity="0.55" />
          <stop offset="1" stop-color="#f7c76a" stop-opacity="0" />
        </radialGradient>
      </defs>
      <ellipse class="glow" data-glow cx="0" cy="8" rx="64" ry="54" fill="url(#lamp-glow)" />
      <path class="plate" d="M-10 0v2.6h20V0" />
      <path class="dome" d="M-15 2.6H15A15 12 0 0 1-15 2.6Z" />
      <path class="seam" d="M-9 6.2q9 4.6 18 0" />
    </svg>
    <span class="switch-hint" data-switch-hint aria-hidden="true">off</span>
  </button>
</div>

<script>
  import './knots.ts';
  import './thread.ts';
  import './lamp.ts';
</script>
