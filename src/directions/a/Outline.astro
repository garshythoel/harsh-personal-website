---
// The outline. One rule for every marker:
//   a swirl means "this opens" and always comes after the text; tap the line to open it
//   a dot is a point in a list, and only appears inside an entry
// Top-level entries carry no marker at all: their date and title sit on the page's left edge.
import { Picture } from 'astro:assets';
import type { Item } from '../../content';

interface Props {
  items: Item[];
  depth?: number;
}
const isPlaceholder = (s?: string) => !s || s.includes('[');
// placeholders ([like this]) are never shown, and nor is a heading that only held placeholders
// ("What we did" before it is written); a line left with nothing under it becomes a plain bullet
const real = (list: Item[], depth: number): Item[] =>
  list.flatMap((it) => {
    if (isPlaceholder(it.text)) return [];
    if (!it.children) return [it];
    const children = real(it.children, depth + 1);
    if (children.length) return [{ ...it, children }];
    return depth === 0 ? [{ ...it, children: undefined }] : [];
  });
const { depth = 0 } = Astro.props;
const items = real(Astro.props.items, depth);
// links to other sites open in a new tab
const out = { target: '_blank', rel: 'noopener' };
// a line whose `linkText` is set links just those words; the rest stays plain
const split = (item: Item) => {
  const at = item.linkText ? item.text.indexOf(item.linkText) : -1;
  if (at < 0 || isPlaceholder(item.href)) return null;
  return [item.text.slice(0, at), item.linkText!, item.text.slice(at + item.linkText!.length)];
};
// the swirl coils from its centre outward and runs on into a stem that is never drawn
const swirl = 'M7.40 6.00L7.47 6.10L7.51 6.23L7.51 6.37L7.48 6.53L7.40 6.69L7.27 6.83L7.10 6.94L6.89 7.02L6.66 7.05L6.41 7.02L6.16 6.94L5.92 6.79L5.70 6.58L5.54 6.31L5.43 6.00L5.38 5.66L5.42 5.30L5.54 4.94L5.74 4.60L6.02 4.30L6.37 4.06L6.78 3.89L7.23 3.81L7.70 3.83L8.18 3.96L8.63 4.19L9.03 4.52L9.37 4.95L9.61 5.44L9.75 6.00L9.77 6.59L9.66 7.18L9.41 7.75L9.05 8.28L8.57 8.72L8.00 9.06L7.34 9.28L6.65 9.36L5.93 9.29L5.23 9.06L4.58 8.68L4.01 8.17L3.56 7.53L3.24 6.80L3.08 6.00L3.08 5.17L3.27 4.34L3.63 3.55L4.16 2.85L4.84 2.26L5.64 1.82L6.53 1.55L7.48 1.47L8.43 1.60L9.35 1.92L10.20 2.44L10.94 3.14L11.52 3.99L11.91 4.96L12.10 6.00C12.10 9.80 7 9.40 7 13.40L7 22';
---
<ul class:list={['outline', `depth-${depth}`]}>
  {items.map((item, i) => {
    const parts = split(item);
    const text = parts ? (
      <span class="text">{parts[0]}<a href={item.href} {...out}>{parts[1]}</a>{parts[2]}</span>
    ) : item.href && !isPlaceholder(item.href) && !item.children ? (
      <a class="text" href={item.href} {...out}>{item.text}</a>
    ) : (
      <span class="text">{item.text}</span>
    );
    const subtitle = item.subtitle && <span class="subtitle">{item.subtitle}</span>;
    // portrait photos are set narrower, so they carry about the same weight as landscape ones;
    // wide screenshots get the full text width, so the words in them stay readable
    const shape = item.image && item.image.src.width / item.image.src.height;
    const wide = !!shape && shape > 2.5;
    const shot = item.image && (
      <Picture
        class:list={['shot', { tall: shape! < 1, wide }]}
        src={item.image.src}
        alt={item.image.alt}
        widths={wide ? [480, 800, 1200] : [320, 480, 720]}
        sizes={wide ? '(min-width: 40rem) 36rem, 85vw' : '(min-width: 40rem) 16rem, 60vw'}
        formats={['avif']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
      />
    );
    const opens = (
      <svg class="mark trail" viewBox="1.5 0.5 11 11" aria-hidden="true" focusable="false">
        <!-- the coil and an arrowhead at its outer end turn together -->
        <g class="swirl-turn">
          <path class="swirl" pathLength="1" d={swirl} />
          <path class="swirl-tip" d="M10.75 4.85L12.1 6.35L13.45 4.85" />
        </g>
      </svg>
    );
    const dot = depth > 0 && (
      <svg class="mark" viewBox="0 0 14 22" aria-hidden="true" focusable="false">
        <circle class="dot" cx="7" cy="6" r="2.1" />
      </svg>
    );
    return (
    // lines that ran side by side (the next one has no years of its own) share one date
    <li style={`--i:${i}`} class:list={{ 'shares-years': item.years && items[i + 1] && !items[i + 1].years }}>
      {item.years && (
        <span class="when">
          {item.years.split(' – ').map((y, j) => (
            <>{j > 0 && <span class="to" aria-hidden="true">–</span>}<span class="y">{y}</span></>
          ))}
        </span>
      )}
      {item.children && item.open ? (
        <>
          <div class="line held-open">
            {dot}
            {text}
            {subtitle}
          </div>
          <div class="kids">
            <Astro.self items={item.children} depth={depth + 1} />
          </div>
        </>
      ) : item.children ? (
        <details class="tied" data-tied>
          <summary class="line">
            {dot}
            {text}{opens}{item.hint && <span class="hint">{' '}{item.hint}</span>}
            {subtitle}
          </summary>
          <div class="kids" data-kids>
            {shot && <div class="kids-shot">{shot}</div>}
            <Astro.self items={item.children} depth={depth + 1} />
          </div>
        </details>
      ) : (
        <div class="line leaf">
          {dot}
          {text}
          {subtitle}
          {shot}
        </div>
      )}
    </li>
    );
  })}
</ul>
